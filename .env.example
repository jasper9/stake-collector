# Copy this file to .env (in this folder) and fill in what you use.
# .env holds secrets: never commit or share it. Real environment variables
# win over the values in .env.

# Solana RPC. Use one with full transaction history for old years.
# A Helius URL also makes `sync` faster (getTransactionsForAddress).
SOLANA_RPC_URL=

# Valigator's price API (not public), for `prices` and
# `report --usd --fetch-prices`. Without it, reports are in SOL only.
WEBGATOR_API_URL=
WEBGATOR_API_KEY=

# Where the store lives (default: the data/ folder next to stake_tips.py).
# STAKE_TIPS_DATA=
